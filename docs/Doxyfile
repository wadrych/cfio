# Doxyfile for C-FIO project

PROJECT_NAME           = "C-FIO"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Multi-threaded NVMe I/O benchmarking tool"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp
EXCLUDE_PATTERNS       = */build/* */tests/* */.git/*

CLANG_ASSISTED_PARSING = NO
BUILTIN_STL_SUPPORT    = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
UML_LOOK               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: warning: $text"

QUIET                  = NO
SORT_MEMBER_DOCS       = YES
SHOW_NAMESPACES        = YES
